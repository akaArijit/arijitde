# PgBouncer Configuration (for local development)
# Copy to .env and fill in your values

# Neon Database (Production - already has built-in pooler)
DATABASE_URL="postgresql://user:password@ep-xxx.pooler.neon.tech/dbname?sslmode=require&channel_binding=require"

# Local PgBouncer (Development - optional)
# PGBOUNCER_URL="postgresql://postgres:postgres@localhost:6432/finanalysis?pgbouncer=true&connect_timeout=15"

# Local PostgreSQL (Development - if not using Neon)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=finanalysis
# DB_USER=postgres
# DB_PASSWORD=postgres

# JWT Secret (required)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# OTP Secret (required - separate from JWT_SECRET)
OTP_SECRET="your-otp-secret-min-32-chars"

# PAN Verification Secret (required - separate from JWT_SECRET for security isolation)
PAN_VERIFICATION_SECRET="your-pan-verification-secret-min-32-chars"

# Refresh Token Feature Flag (default: true)
ENABLE_REFRESH_TOKENS="true"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Gmail for OTP emails
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-gmail-app-password"

# Optional: Explicit Gmail SMTP IPv4 host (bypasses DNS resolution issues on IPv6-only networks)
# Known Gmail SMTP IPv4: 74.125.133.108, 74.125.193.108, 74.125.67.108
# GMAIL_SMTP_HOST="74.125.133.108"

# Grok API Key
GROK_API_KEY="your-grok-api-key"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000,http://localhost:3001,https://finanalysis.site"

# Upstash Redis (for caching)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Render Keep-Alive (optional)
RENDER_EXTERNAL_URL="https://your-app.onrender.com"

# Sentry Error Tracking (optional)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"