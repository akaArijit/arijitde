// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(uuid())
  phone             String?             @unique
  email             String?
  pan               String?             @unique
  name              String?
  password          String?
  role              Role                @default(GUEST)
  googleId          String?             @unique
  dob               DateTime?
  anniversary       DateTime?
  createdAt         DateTime            @default(now())
  referralCode      String?             @unique
  referrerId        String?
  referrer          User?               @relation("UserReferrals", fields: [referrerId], references: [id])
  referrals         User[]              @relation("UserReferrals")
  assessments       Assessment[]
  portfolios        Portfolio[]
  leads             Lead[]
  client            Client?
  advisorySessions  AdvisorySession[]
  supportQueries    SupportQuery[]
}

enum Role {
  GUEST
  CLIENT
  ADMIN
}

model Assessment {
  id                  String      @id @default(uuid())
  userId              String
  age                 Int
  goal                Goal
  ageRange            String?
  lifeStage           String?
  investmentTenure    String?
  isCompletePortfolio Boolean?
  investmentStyle     String?
  expectedReturn      String?
  riskBehavior        String?
  monthlyInvestment   String?
  emergencyFund       String?
  createdAt           DateTime    @default(now())
  user                User        @relation(fields: [userId], references: [id])
  portfolios          Portfolio[]

  @@index([userId])
}

enum Goal {
  WEALTH_CREATION
  RETIREMENT
  HOUSE_PURCHASE
  CHILD_EDUCATION
  MARRIAGE
  PASSIVE_INCOME
  TAX_SAVING
  NOT_SURE_YET
  // Legacy values for backward compatibility
  SHORT_TERM
  LONG_TERM
  EXPLORING
}

model Portfolio {
  id           String         @id @default(uuid())
  userId       String
  assessmentId String
  uploadType   UploadType
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id])
  assessment   Assessment     @relation(fields: [assessmentId], references: [id])
  rows         PortfolioRow[]
  score        Score?

  @@index([userId])
  @@index([assessmentId])
}

enum UploadType {
  EXCEL
  MANUAL
  FOLIO_IMPORT
}

model PortfolioRow {
  id           String    @id @default(uuid())
  portfolioId  String
  fundName     String
  type         FundType
  startDate    DateTime
  sipAmount    Float
  invested     Float
  currentValue Float
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id])

  @@index([portfolioId])
}

enum FundType {
  SIP
  LUMPSUM
}

model Score {
  id              String   @id @default(uuid())
  portfolioId     String   @unique
  total           Int
  goalAlignment   Int
  assetAlloc      Int
  diversification Int
  discipline      Int
  efficiency      Int
  tag             ScoreTag
  insights        Json
  createdAt       DateTime @default(now())
  portfolio       Portfolio @relation(fields:[portfolioId], references:[id])
}

enum ScoreTag {
  ALIGNED
  MODERATE
  NEEDS_REVIEW
  NEEDS_STRUCTURING
}



model Lead {
  id        String     @id @default(uuid())
  userId    String
  scoreId   String?
  name      String
  phone     String
  slot      DateTime?
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
}



model Client {
  id           String   @id @default(uuid())
  userId       String   @unique
  activatedAt  DateTime @default(now())
  advisorNotes String?
  activePlan   String?
  user         User     @relation(fields: [userId], references: [id])
}

model Folio {
  id                   String   @id @default(uuid())
  existingClientId     String?
  existingClient       ExistingClient? @relation(fields: [existingClientId], references: [id], onDelete: Cascade)
  clientName           String?
  clientPan            String?
  clientAadhaar        String?
  nameAsPerFolio       String?
  panAsPerFolio        String?
  folioNumber          String?
  schemeName           String?
  units                Float?
  aum                  Float?
  purchaseValue        Float?
  email                String?
  mobile               String?
  dob                  String?
  holding              String?
  taxStatus            String?
  comments             String?
  freezeDate           String?
  address1             String?
  address2             String?
  address3             String?
  bankName             String?
  bankAddress          String?
  accountNumber        String?
  ifscCode             String?
  accountType          String?
  jointHolder1Name     String?
  jointHolder1Pan      String?
  jointHolder1Kyc      String?
  jointHolder1Aadhaar  String?
  jointHolder2Name     String?
  jointHolder2Pan      String?
  jointHolder2Kyc      String?
  jointHolder2Aadhaar  String?
  guardianName         String?
  guardianPan          String?
  guardianKyc          String?
  guardianAadhaar      String?
  nomineeOpted         String?
  nominee1Name         String?
  nominee1Relation     String?
  nominee1Percentage   String?
  nominee2Name         String?
  nominee2Relation     String?
  nominee2Percentage   String?
  nominee3Name         String?
  nominee3Relation     String?
  nominee3Percentage   String?
  ftFolio              String?
  folioType            String?
  clientDematId        String?
  dpId                 String?
  appCode              String?
  equityCode           String?
  familyHead           String?
  iwellCode            String?
  iwellCode2           String?
  nomineeDetails       String?
  nomineeDetails2      String?
  nomineeDetails3      String?
  operations           String?
  operationsCode       String?
  relationshipManager  String?
  relationshipManager2 String?
  subBroker            String?
  subBrokerCode        String?
  lastUsedArn          String?
  createdAt            DateTime @default(now())

  @@index([existingClientId])
  @@index([existingClientId, createdAt])
  @@index([schemeName, existingClientId])
  @@index([createdAt])
  @@index([clientName])
  @@index([clientPan])
  @@index([folioNumber])
  @@index([schemeName])
  @@index([email])
  @@index([mobile])
}

model ExistingClient {
  id                         String   @id @default(uuid())
  folios                     Folio[]
  title                      String?
  name                       String?
  pan                        String?
  appCode                    String?
  email                      String?
  disableEmail               String?
  secondaryEmail             String?
  iwellCode                  String?
  username                   String?
  mobile                     String?
  landline                   String?
  dob                        String?
  birthdayWish               String?
  anniversary                String?
  dateOfDeath                String?
  familyHead                 String?
  familyHeadIwellCode        String?
  referredBy                 String?
  iwellCode2                 String?
  familyHeadIwellCode2       String?
  address1                   String?
  address2                   String?
  address3                   String?
  city                       String?
  state                      String?
  country                    String?
  pinCode                    String?
  clientRating               String?
  firstInvestmentDate        String?
  reviewFrequency            String?
  lastReviewDate             String?
  modelName                  String?
  fileNumber                 String?
  tags                       String?
  updateLog                  String?
  equityCode1                String?
  equityCode2                String?
  depository                 String?
  dpName                     String?
  dpId                       String?
  npsAccountNumber           String?
  annualIncome               String?
  profession                 String?
  billState                  String?
  billGstin                  String?
  aum                        Float?
  targetSipAmount            Float?
  targetElssAmount           Float?
  targetEquityAllocation     Float?
  targetDebtAllocation       Float?
  preferredBillingMode       String?
  equityMfBilling            Float?
  debtMfBilling              Float?
  sharesBilling              Float?
  bondsBilling               Float?
  fixedDepositBilling        Float?
  otherAssetBilling          Float?
  remarks                    String?
  bankDetails                String?
  overseasAddress1           String?
  overseasAddress2           String?
  overseasAddress3           String?
  overseasCity               String?
  overseasState              String?
  overseasCountry            String?
  overseasPin                String?
  overseasPhone              String?
  overseasMobile             String?
  kycStatus                  String?
  aadhaar                    String?
  nominee1Name               String?
  nominee1Relation           String?
  nominee1Dob                String?
  nominee1Percentage         String?
  nominee2Name               String?
  nominee2Relation           String?
  nominee2Dob                String?
  nominee2Percentage         String?
  nominee3Name               String?
  nominee3Relation           String?
  nominee3Dob                String?
  nominee3Percentage         String?
  
  // Valuation fields merged from PortfolioValuation
  balanceUnits               Float?
  purchaseValue              Float?
  currentValue               Float?
  oneDayChange               Float?
  dividend                   Float?
  averageHoldingDays         Float?
  gain                       Float?
  absoluteReturn             Float?
  cagr                       Float?
  xirr                       Float?
  
  createdAt                  DateTime @default(now())

  @@index([createdAt])
  @@index([name])
  @@index([pan])
  @@index([email])
  @@index([mobile])
  @@index([iwellCode])
  @@index([appCode])
  @@index([city])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}



enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  REFUNDED
}



model AdvisorySession {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  preferredSlot1 DateTime
  preferredSlot2 DateTime
  preferredSlot3 DateTime
  confirmedSlot  DateTime?
  googleMeetLink String?
  status         SessionStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
}

model SupportQuery {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

